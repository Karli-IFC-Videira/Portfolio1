<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE urlrewrite
    PUBLIC "-//tuckey.org//DTD UrlRewrite 5.1//EN"
    "https://tuckey.org/res/dtds/urlrewrite5.1.dtd">

<urlrewrite>
    <rule>
        <from>^/index$</from>
        <to>/index.jsp</to>
    </rule>

    <rule>
        <from>^/home$</from>
        <to>/home.jsp</to>
    </rule>

    <rule>
        <from>^/contatos$</from>
        <to>/contatos.jsp</to>
    </rule>
</urlrewrite>